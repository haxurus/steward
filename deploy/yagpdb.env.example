# YAGPDB settings for VPS01: /srv/docker/yagpdb/yagpdb.env (root-only, sudoedit).
# Non-secret values only. Secrets are files in /srv/docker/yagpdb/secrets/app/,
# named after the variable (docs/DEPLOYMENT.md, section 3).
# Database, Redis, ports and proxy headers are fixed in docker-compose.yml.
#
# Every option is listed in yagpdb_docker/app.example.env; names derive from config
# keys (yagpdb.foo.bar -> YAGPDB_FOO_BAR). Values saved from the bot owner panel
# (/admin/config) are stored in Redis and take precedence over this file.

########## Required ##########

# Public host of the control panel, without protocol.
YAGPDB_HOST=yagpdb.haxurus.com
# Discord application ID (Developer Portal > General Information).
YAGPDB_CLIENTID=000000000000000000
# Discord user ID of the bot owner: full access to /admin and owner-only commands.
YAGPDB_OWNER=000000000000000000
# Extra owners, comma separated.
YAGPDB_OWNERS=

########## Behaviour ##########

# Private bot for Haxurus servers: unlock premium limits everywhere it is installed.
YAGPDB_PREMIUM_ALL_GUILDS_PREMIUM=true
# Built-in commands through the text prefix (slash commands always work).
YAGPDB_ENABLE_PREFIX_COMMANDS=false
YAGPDB_ENABLE_PREFIX_COMMANDS_WARNING=false
# Privacy-affecting features, off unless needed (breaking_changes.md).
YAGPDB_ENABLE_USERNAME_TRACKING=false
YAGPDB_VERIFICATION_TRACK_IPS=false
# Days of message logs to keep (0 = forever). The bot owner can change it without
# restart in /admin/config (custom.message_log_retention_days), which wins over this.
YAGPDB_CUSTOM_MESSAGE_LOG_RETENTION_DAYS=30

########## Optional: notification channels (IDs) ##########

# Servers the bot joins or leaves.
YAGPDB_BOTLEAVESJOINS=
# Gateway connection events and status.
YAGPDB_CONNEVT_CHANNEL=
YAGPDB_CONNSTATUS_CHANNEL=
# DMs reported by users.
YAGPDB_DM_REPORT_CHANNEL=0

########## Optional: integrations (public IDs; secrets go in secrets/app) ##########

# Twitch feeds: also YAGPDB_TWITCH_CLIENTSECRET as a secret file.
YAGPDB_TWITCH_CLIENTID=
# Reddit feeds: also YAGPDB_REDDIT_CLIENTSECRET and YAGPDB_REDDIT_REFRESHTOKEN.
YAGPDB_REDDIT_CLIENTID=
YAGPDB_REDDIT_REDIRECT=
YAGPDB_REDDIT_DEVUSERNAME=
# Verification plugin: also YAGPDB_GOOGLE_RECAPTCHA_SECRET.
YAGPDB_GOOGLE_RECAPTCHA_SITE_KEY=
# YouTube feeds: secrets google-credentials.json and YAGPDB_YOUTUBE_VERIFY_TOKEN.
