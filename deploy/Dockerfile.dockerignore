# Used only by deploy/Dockerfile (BuildKit picks <Dockerfile>.dockerignore), so the
# upstream yagpdb_docker build keeps its own context with .git.
.git
.github
.vscode
**/*.env
!deploy/steward.env.example
**/secrets
**/backups
**/*.log
**/shutdown_logs
**/soundboard/queue
**/soundboard/ready
**/safebrowsing_db
steward_deploy
steward_deploy.pub
